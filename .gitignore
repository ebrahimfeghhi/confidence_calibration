__pycache__/
*.pyc
results/*
!results/.gitkeep
# the train/test split DEFINES the experiment — it must be version-controlled
!results/csv_files/
results/csv_files/*
!results/csv_files/train_test_split.json
!results/csv_files/difficulty_recomputed.json
# Protenix scored by OST — the SAME tool that scored ESMFold2 (ground truth)
!results/csv_files/dockq_ost_protenix.csv
# DockQ matrices are 4.1 GB of generated data — out of git, but keep the timings
!results/dockq_full/
results/dockq_full/*
!results/dockq_full/timings.csv
steer/data/

# steer experiment outputs (co-located with scripts)
steer/experiments/*.csv
steer/experiments/*.npy
steer/experiments/*.png
steer/experiments/*.log
steer/experiments/logs/
steer/experiments/*.out
steer/experiments/*.pt
steer/experiments/decoded_*/
steer/experiments/*_state/
steer/experiments/*_STOP
steer/experiments/log_*.txt
steer/experiments/chain_order_*.txt

# Archived experiments: kept on disk, out of git entirely (1.8 GB of .npy/.pt tensors).
# A leading-slash-free pattern with an internal slash is anchored to the repo root, so the
# old `archive/**/*.npy` form never matched steer/experiments/archive/ — hence the bare name.
archive/

# ---- SERVER-MOVE BACKUP (2026-07-13) ----------------------------------------
# The box is being decommissioned. These are the irreplaceable RESULTS: OST ground
# truth, the cluster sweep, and the index files needed to read the DockQ matrices.
# Compressed they are ~30 MB, so they live in git. The 4.1 GB of .npy matrices and
# the 600 GB of raw predictions do NOT fit on GitHub and go by scp.
!results/csv_files/*.csv.gz
!results/cluster_sweep/
results/cluster_sweep/*
!results/cluster_sweep/sweep.csv
!results/cluster_sweep/clusters.json.gz
!results/dockq_full/index_csvs.tar.gz
!results/figures/

# vendored Protenix copy: byte-compiled files only, the source itself IS tracked
confident_decoy_experiments/vendor/**/__pycache__/
confident_decoy_experiments/vendor/**/*.pyc

# confident-decoy run output: ~103 GB of predictions and scored artifacts.
# Lives INSIDE the repo (moved 2026-08-10) so everything the project produces is
# under tts_abag, but is not tracked. /home/ebrahim/confident_decoy_experiments/
# holds symlinks here so absolute paths in old logs and configs still resolve.
confident_decoy_experiments/artifacts/
confident_decoy_experiments/predictions/

# confident-decoy ops: keep the watcher/runner SCRIPTS, never their logs (xfer.log alone is 48 MB)
confident_decoy_experiments/ops/*.log
# 17 MB of release_date_cache backups pulled from naboo before it was retired -- data, not code
confident_decoy_experiments/handoff/naboo_pull/
