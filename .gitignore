__pycache__/
*.pyc
results/*
!results/.gitkeep
# the train/test split DEFINES the experiment — it must be version-controlled
!results/csv_files/
results/csv_files/*
!results/csv_files/train_test_split.json
!results/csv_files/difficulty_recomputed.json
# Protenix scored by OST — the SAME tool that scored ESMFold2 (ground truth)
!results/csv_files/dockq_ost_protenix.csv
# DockQ matrices are 4.1 GB of generated data — out of git, but keep the timings
!results/dockq_full/
results/dockq_full/*
!results/dockq_full/timings.csv
steer/data/

# steer experiment outputs (co-located with scripts)
steer/experiments/*.csv
steer/experiments/*.npy
steer/experiments/*.png
steer/experiments/*.log
steer/experiments/logs/
steer/experiments/*.out
steer/experiments/*.pt
steer/experiments/decoded_*/
steer/experiments/*_state/
steer/experiments/*_STOP
steer/experiments/log_*.txt
steer/experiments/chain_order_*.txt

# Archived experiments: kept on disk, out of git entirely (1.8 GB of .npy/.pt tensors).
# A leading-slash-free pattern with an internal slash is anchored to the repo root, so the
# old `archive/**/*.npy` form never matched steer/experiments/archive/ — hence the bare name.
archive/

# ---- SERVER-MOVE BACKUP (2026-07-13) ----------------------------------------
# The box is being decommissioned. These are the irreplaceable RESULTS: OST ground
# truth, the cluster sweep, and the index files needed to read the DockQ matrices.
# Compressed they are ~30 MB, so they live in git. The 4.1 GB of .npy matrices and
# the 600 GB of raw predictions do NOT fit on GitHub and go by scp.
!results/csv_files/*.csv.gz
!results/cluster_sweep/
results/cluster_sweep/*
!results/cluster_sweep/sweep.csv
!results/cluster_sweep/clusters.json.gz
!results/dockq_full/index_csvs.tar.gz
!results/figures/

# vendored Protenix copy: byte-compiled files only, the source itself IS tracked
confident_decoy_experiments/vendor/**/__pycache__/
confident_decoy_experiments/vendor/**/*.pyc

# confident-decoy run output: ~103 GB of predictions and scored artifacts.
# Lives INSIDE the repo (moved 2026-08-10) so everything the project produces is
# under tts_abag, but is not tracked. /home/ebrahim/confident_decoy_experiments/
# holds symlinks here so absolute paths in old logs and configs still resolve.
# Renamed 2026-09-18: artifacts/ became experimental_data/ at the repo root when the
# confident_decoy_experiments era was archived. The OLD patterns are kept below because the
# archived tree still contains those directories.
confident_decoy_experiments/artifacts/
confident_decoy_experiments/predictions/
archive/confident_decoy_experiments/artifacts/
archive/confident_decoy_experiments/predictions/

# confident-decoy ops: keep the watcher/runner SCRIPTS, never their logs (xfer.log alone is 48 MB)
confident_decoy_experiments/ops/*.log
# 17 MB of release_date_cache backups pulled from naboo before it was retired -- data, not code
confident_decoy_experiments/handoff/naboo_pull/

# --- environments and bulk data: code only in git ---
# gitignore has no trailing comments: a comment after a pattern becomes part of it
# 6.2 GB virtualenv, moved to envs/ at the repo root (it is a live dependency of eval/)
envs/
confident_decoy_experiments/envs/
archive/confident_decoy_experiments/envs/
confident_decoy_experiments/predictions/
# 166 GB of generated structures
poses/
# vendored third-party source
external/

# v2 carries an EMPTY skeleton of experimental_data so the layout is visible. Only the directory
# markers are tracked -- never data. Anything with content is re-ignored below.
!diffusion_commit_clean_v2/experimental_data/
!diffusion_commit_clean_v2/experimental_data/**/
!diffusion_commit_clean_v2/experimental_data/**/.gitkeep
diffusion_commit_clean_v2/experimental_data/**/*.cif
diffusion_commit_clean_v2/experimental_data/**/*.csv
diffusion_commit_clean_v2/experimental_data/**/*.npz
diffusion_commit_clean_v2/experimental_data/**/*.json
diffusion_commit_clean_v2/experimental_data/**/*.tsv

# matrices and other large binaries never belong in the repo
*.npz

# --- experimental_data: keep the light files, exclude the bulk ------------------------------------
# 264 GB total: 150 GB of poses, 79 GB of matrices, 12 GB of MSAs, 12 GB of per-pose confidence json.
# Blacklisting the heavy types rather than whitelisting the light ones, because a blanket
# `experimental_data/**` also matches the DIRECTORIES -- git then never descends and no later
# negation can rescue anything inside. What stays in git: queues, selections, scores, roles, diffs.
experimental_data/**/*.cif
experimental_data/**/*.npz
experimental_data/**/*.json
experimental_data/**/*.a3m
experimental_data/**/*.log
experimental_data/**/*.pt
experimental_data/**/*.pdb
experimental_data/**/*.png
experimental_data/**/*.m8
experimental_data/**/*.txt
experimental_data/**/*.lock
experimental_data/**/*.gz
# third-party reference data, not our results: 225 MB of PDB sequence dumps
experimental_data/archive/**
# fold output trees, claim markers and template namespaces: bookkeeping, not results
experimental_data/**/out/**
experimental_data/**/claims/**
experimental_data/**/ns/**
experimental_data/**/ns_stale*/**
experimental_data/**/build_log*.csv
# a benchmark's free pool made of symlinks into its original run: foldbench_setup.py rebuilds them
experimental_data/protenix/*/free/*/

# watcher runtime state (last claims/rows per arm) -- rewritten every 30 min
experimental_data/.watch_state

# saved z/s trunks (bf16), too big for git -- pair_rep_scatter pilot
pair_rep_scatter/trunk_pilot/trunks/
pair_rep_scatter/trunk_pilot/free/

# batch2: saved trunks (bf16) and fold outputs
pair_rep_scatter/batch2/trunks/
pair_rep_scatter/batch2/free/
pair_rep_scatter/batch2/resume/

# pipeline: per-complex working data, kept trunks, archived test runs (large)

# self_template_from_trunks: per-complex data, kept trunks and archive are large
self_template_from_trunks/data/
self_template_from_trunks/kept_trunks/
self_template_from_trunks/archive/

# self_template_from_trunks: run state and logs (results are committed deliberately, not automatically)
self_template_from_trunks/*.log
self_template_from_trunks/controller.stdout
self_template_from_trunks/.report_marker
self_template_from_trunks/production_started*.txt
self_template_from_trunks/STOP
self_template_from_trunks/code/history/
/pair_rep_scatter

# self-distillation dropout pilot (2026-10-02): trunks, poses and per-fold jsons are data, not code
self_distill_dropout/**/*.npz
self_distill_dropout/**/*.cif
self_distill_dropout/**/free_*/
self_distill_dropout/**/zdrop_*/
self_distill_dropout/**/trunks/
self_distill_dropout/**/*.log

# extra_training: large transient data, never committed
extra_training/data/
extra_training/msa_out/
extra_training/msa_queries/*.a3m
tools/
envs/
extra_training/msa_work/
extra_training/val_fold/
extra_training/val_refs/
extra_training/data/training_cifs/
extra_training/protenix_root/
extra_training/*.log

# runtime state of the E-to-I chain: one word naming the current stage, not code
extra_training/*.state
