+        import numpy as _np
+        st = gemmi.read_structure(cif_path)
+        st.setup_entities()
+        xyz = _np.array([[a.pos.x, a.pos.y, a.pos.z]
+                         for ch in st[0] for res in ch for a in res], dtype=_np.float32)
+        mask = input_feature_dict["distogram_rep_atom_mask"].bool().cpu().numpy()
+        assert xyz.shape[0] == mask.shape[0], (
