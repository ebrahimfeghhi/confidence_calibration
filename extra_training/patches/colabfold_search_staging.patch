+def _emit_taxid() -> bool:
+    """PATCHED (tts_abag): emit uniref_tax.m8 alongside uniref.a3m.
+
+    Protenix's MSA pipeline needs it: scripts/msa/step3-uniref_add_taxid.py reads "the uniref_tax.m8
+    from output of mmseqs(colabfold search)" to write NCBI TaxIDs into the a3m headers, and
+    step4-split_msa_to_uniref_and_others.py then splits the result into pairing.a3m and
+    non_pairing.a3m. Without the taxids there is no paired MSA, and every Protenix job json requires
+    a pairedMsaPath. Upstream ColabFold does not produce this file (see ColabFold issue #216); the
+    convertalis call below is the one their step2 notebook instructs adding.
+    """
+    import os
+    return os.environ.get("COLABFOLD_EMIT_TAXID", "1") == "1"
+
+
+def _keep_intermediates() -> bool:
+    """PATCHED (tts_abag): retain uniref.a3m and prof_res so the uniref and env searches can be run
+    in separate passes with only one large database resident at a time."""
+    import os
+    return os.environ.get("COLABFOLD_KEEP_INTERMEDIATES") == "1"
